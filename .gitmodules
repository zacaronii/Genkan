[submodule "third_party/hoshidicts"]
	path = third_party/hoshidicts
	url = https://github.com/bee-san/hoshidicts.git
[submodule "libretrodroid/src/main/cpp/libretro/libretro-common"]
	path = libretrodroid/src/main/cpp/libretro/libretro-common
	url = https://github.com/libretro/libretro-common
[submodule "third_party/bsnes-mercury"]
	path = third_party/bsnes-mercury
	url = https://github.com/libretro/bsnes-mercury
[submodule "third_party/dolphin"]
	path = third_party/dolphin
	url = https://github.com/libretro/dolphin
	shallow = true
	update = none
[submodule "third_party/yomikata"]
	path = third_party/yomikata
	url = ../yomikata
	shallow = true
[submodule "third_party/beetle-saturn"]
	path = third_party/beetle-saturn
	url = https://github.com/libretro/beetle-saturn-libretro
[submodule "third_party/flycast"]
	path = third_party/flycast
	url = https://github.com/flyinghead/flycast
	shallow = true
	update = none
[submodule "third_party/lrps2"]
	path = third_party/lrps2
	url = https://github.com/libretro/parallel-ps2
	shallow = true
	update = none
