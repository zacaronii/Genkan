<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The OCR test card speaks its lines; the TTS engine must be visible to bind to it. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application>
        <!-- Debug builds only: dictionary checks from adb (DUMP is held by the shell). -->
        <receiver
            android:name=".debug.DictionaryDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.genkan.debug.LOOKUP" />
                <action android:name="app.genkan.debug.IMPORT_DICTIONARIES" />
                <action android:name="app.genkan.debug.NOW_PLAYING" />
                <action android:name="app.genkan.debug.FORGET_GAME" />
                <action android:name="app.genkan.debug.SAVE_SYNC" />
                <action android:name="app.genkan.debug.SHIZUKU_PROBE" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: a stand-in game screen for OCR tests. -->
        <activity
            android:name=".debug.OcrTestCardActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.Genkan" />
    </application>
</manifest>
