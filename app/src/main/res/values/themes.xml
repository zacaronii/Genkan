<resources>
    <style name="Theme.Genkan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Invisible, untouchable, no animation: exists only to pull WM focus to its display. -->
    <style name="Theme.Genkan.FocusDirector" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- No starting window either: it is a second surface flashing up on the top screen. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
