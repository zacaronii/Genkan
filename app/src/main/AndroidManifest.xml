<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Recording what the game plays (playback capture) for cards' sentence audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The headphones list: bonded audio devices and which one is connected (asked on first use). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Games go to a shared ROMs folder that the emulators read. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ScopedStorage" />

    <!-- Play time: when the emulator was actually in front (granted in system settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility for the emulators Genkan launches (launch/EmulatorCatalog.kt). -->
    <queries>
        <!-- The system's output picker, the headphones' fallback when Shizuku can't connect. -->
        <intent>
            <action android:name="com.android.systemui.action.LAUNCH_MEDIA_OUTPUT_DIALOG" />
        </intent>
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.ra32" />
        <package android:name="com.github.stenzek.duckstation" />
        <package android:name="com.armsx2" />
        <package android:name="come.nanodata.armsx2" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.handheld" />
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="app.gamenative" />
        <!-- The Apps shelf lists launchable apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        Predictive back off: the library's Back and BottomBack (Back for what is open on the bottom
        screen) both read the system's Back as a KEYCODE_BACK key event, which an app targeting
        SDK 36 would otherwise stop getting on Android 16.
    -->
    <application
        android:enableOnBackInvokedCallback="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".GenkanApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Genkan">

        <!-- Top screen (display 0): launcher. Also reachable from the app drawer. -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            HOME entry point. Disabled by default so installing Genkan never takes over Home;
            the setup screen enables it before asking for ROLE_HOME (see HomeAppComponent).
        -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".HomeActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
            Bottom screen: reading companion. The OS starts it on the secondary display once
            Genkan is the default home, and respawns it after finish(); release it only by
            disabling the component (SecondaryHomeComponent).
        -->
        <activity
            android:name=".LowerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/lower_label"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".hardware.FocusDirectorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Genkan.FocusDirector" />

        <!--
            The built-in player, in its own process: a core can't be loaded twice in one, and a
            crashing core must not take the launcher down. It checks in with CoreHostService.
        -->
        <activity
            android:name=".core.CoreActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":core"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="app.genkan.core"
            android:theme="@style/Theme.Genkan.Core" />

        <service
            android:name=".core.CoreHostService"
            android:exported="false" />

        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".capture.CaptureConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Genkan.FocusDirector" />

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shizuku hands Genkan a binder for its file helper (saves in other apps' Android/data). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- adb recovery (scripts/recover-home.sh). DUMP is held by the shell, not by apps. -->
        <receiver
            android:name=".home.RecoveryReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.genkan.action.RELEASE_HOME" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
