diff --git a/Source/Core/DolphinLibretro/VideoContexts/GLContextLR.cpp b/Source/Core/DolphinLibretro/VideoContexts/GLContextLR.cpp
index a3f108e..1db9f55 100644
--- a/Source/Core/DolphinLibretro/VideoContexts/GLContextLR.cpp
+++ b/Source/Core/DolphinLibretro/VideoContexts/GLContextLR.cpp
@@ -345,6 +345,16 @@ bool GLContextLR::Initialize(const WindowSystemInfo& wsi, bool stereo, bool core
   return true;
 }
 
+void GLContextLR::Update()
+{
+  // The output is sized by the EFB scale, which can change as the game runs (retro_run asks the
+  // presenter for a resize then, which comes here): set only at start, a smaller scale drew the
+  // old size into the frontend's smaller framebuffer.
+  const int efbScale = Libretro::Options::GetCached<int>(Libretro::Options::gfx_settings::EFB_SCALE, 1);
+  m_backbuffer_width = Libretro::Video::GetAdjustedBaseWidth() * efbScale;
+  m_backbuffer_height = Libretro::Video::GetAdjustedBaseHeight() * efbScale;
+}
